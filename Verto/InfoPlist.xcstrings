    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo translation uses the camera to capture the text in front of you so it can be recognized and translated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción con fotos usa la cámara para capturar el texto que tienes delante y así reconocerlo y traducirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真翻訳では、目の前の文字を認識して翻訳するためにカメラで撮影します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 번역은 눈앞의 글자를 인식하고 번역하기 위해 카메라로 촬영합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照翻译需要使用相机拍摄画面里的文字，用于识别并翻译。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversation translation uses the microphone to recognize and translate your speech in real time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción de conversaciones usa el micrófono para reconocer y traducir tu voz en tiempo real."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話翻訳では、マイクを使って音声をリアルタイムで認識し、翻訳します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 대화 번역은 마이크를 사용해 음성을 실시간으로 인식하고 번역합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话翻译使用麦克风实时识别并翻译你的语音。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition turns your speech into text for translation. When supported, recognition happens on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz convierte tu voz en texto para traducirla. Cuando es compatible, el reconocimiento se realiza en tu dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識は音声をテキストに変換して翻訳に使用します。対応している場合、認識はデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 인식은 음성을 텍스트로 변환해 번역에 사용합니다. 지원되는 경우 기기에서 인식합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音识别会把你的语音转成文字，用于翻译。支持时，识别在设备上完成。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}

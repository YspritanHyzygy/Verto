//
//  中转配置。**这个文件会被提交进公开仓库，任何真值都不许写在这里。**
//
//  真值放进 Secrets.local.xcconfig（已在 .gitignore 里），照 .example 那份填。
//  文件不存在时下面的 #include? 静默跳过，构建照常——克隆仓库的人不必先建文件
//  才能编译，只是那份构建没有中转，会落到系统翻译。
//

// 只写主机名，不写 scheme。xcconfig 把 // 当注释起点，
// 写 https://api.example.com 会被截成 https:，是个查起来很费劲的坑。
VERTO_RELAY_HOST =
VERTO_RELAY_TOKEN =

// 后写的赋值覆盖先写的，所以真值放在最后包含。
#include? "Secrets.local.xcconfig"
